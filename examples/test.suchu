// A self-test of the language, written in the language.
//
// Each case is a function returning "ok". Anything else -- including falling
// off the end, which yields none -- counts as a failure. Run it after touching
// the evaluator: it exercises the surface a program actually stands on.
//
// There is no window here on purpose. A GUI block enters the event loop and
// waits for someone to close it, so it cannot be part of a suite that has to
// finish on its own. See examples/gui for those.

print("=== Suchu feature test suite ===");

passed = 0;
failed = 0;

fun test(name, fn) {
  result = fn();
  if (result == "ok") {
    print("   ok  ", name);
    passed = passed + 1;
  } else {
    print("   FAIL", name);
    failed = failed + 1;
  }
}

// ---------- BASIC SYNTAX ----------
test("arithmetics", fun() {
  a = 5 + 2 * 3 - 1;
  if (a == 10) { return "ok"; }
});

test("comparison", fun() {
  if (2 < 3 && 3 >= 3 && !(2 == 3)) { return "ok"; }
});

test("string concat", fun() {
  s = "Hello" @ " " @ "Suchu";
  if (s == "Hello Suchu") { return "ok"; }
});

test("range inclusive", fun() {
  r = 1..3;
  if (len(r) == 3) { return "ok"; }
});

test("conditional expression", fun() {
  x = if true then 1 else 0;
  if (x == 1) { return "ok"; }
});

test("while loop", fun() {
  c = 0;
  while (c < 3) { c = c + 1; }
  if (c == 3) { return "ok"; }
});

test("break and continue", fun() {
  total = 0;
  i = 0;
  while (true) {
    i = i + 1;
    if (i > 5) { break; }
    if (i % 2 == 0) { continue; }
    total = total + i;
  }
  if (total == 9) { return "ok"; }
});

test("for loop list", fun() {
  total = 0;
  for (x in [1, 2, 3]) { total = total + x; }
  if (total == 6) { return "ok"; }
});

test("match statement", fun() {
  msg = "";
  match 2 {
    case 1 { msg = "a"; }
    case 2 { msg = "b"; }
    default { msg = "c"; }
  }
  if (msg == "b") { return "ok"; }
});

// ---------- FUNCTIONS ----------
test("function + closure", fun() {
  y = 2;
  fun adder(x) { return x + y; }
  if (adder(3) == 5) { return "ok"; }
});

test("falling off the end yields none", fun() {
  fun silent(n) { doubled = n * 2; }
  if (silent(4) == none) { return "ok"; }
});

test("higher order map", fun() {
  fun square(n) { return n * n; }
  result = map(square, [1, 2, 3]);
  if (len(result) == 3 && result[2] == 9) { return "ok"; }
});

test("filter builtin", fun() {
  fun odd(n) { return n % 2 != 0; }
  result = filter(odd, [1, 2, 3, 4, 5]);
  if (len(result) == 3) { return "ok"; }
});

test("reduce builtin", fun() {
  fun add(a, b) { return a + b; }
  total = reduce(add, [1, 2, 3], 0);
  if (total == 6) { return "ok"; }
});

test("recursion", fun() {
  fun factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
  }
  if (factorial(5) == 120) { return "ok"; }
});

// ---------- COLLECTIONS ----------
test("list push and pull", fun() {
  lst = [];
  push(lst, 1);
  push(lst, 2);
  v = pull(lst);
  if (v == 2 && len(lst) == 1) { return "ok"; }
});

test("list sort/reverse/pop", fun() {
  lst = [3, 1, 2];
  lst.sort();
  lst.reverse();
  if (lst.pop() == 1 && len(lst) == 2) { return "ok"; }
});

test("list indexing", fun() {
  lst = [10, 20, 30];
  if (lst[0] == 10 && lst[2] == 30) { return "ok"; }
});

test("set literal drops duplicates", fun() {
  s = set {1, 2, 2};
  if (len(s) == 2) { return "ok"; }
});

test("set union and intersection", fun() {
  a = set {1, 2};
  b = set {2, 3};
  if (len(a | b) == 3 && len(a & b) == 1) { return "ok"; }
});

test("record fields", fun() {
  point = { x: 1; y: 2; };
  if (point.x == 1 && point.y == 2) { return "ok"; }
});

test("string iteration", fun() {
  count = 0;
  for (letter in "Suchu") { count = count + 1; }
  if (count == 5) { return "ok"; }
});

// ---------- BUILTINS ----------
test("sqrt + Pow + abs", fun() {
  a = sqrt(9);
  b = Pow(2, 3);
  c = abs(-5);
  if (a == 3 && b == 8 && c == 5) { return "ok"; }
});

test("integer power stays an integer", fun() {
  if (2 ** 3 == 8 && type(2 ** 3) == "int") { return "ok"; }
});

test("min max round", fun() {
  if (min(2, 5) == 2 && max(2, 5) == 5 && round(2.6) == 3) { return "ok"; }
});

test("len over every kind", fun() {
  if (len("abc") == 3 && len([1, 2]) == 2 && len(set {1}) == 1) { return "ok"; }
});

test("type builtin", fun() {
  if (type(3) == "int" && type("a") == "string" && type(2.5) == "float") {
    return "ok";
  }
});

// max_length caps the result, the "..." included: eight characters into five
// leaves room for two and the ellipsis. Text that already fits is untouched.
test("truncate", fun() {
  if (truncate("abcdefgh", 5) == "ab..." && truncate("abcdefgh", 8) == "abcdefgh") {
    return "ok";
  }
});

// ---------- ERROR HANDLING ----------
test("assert passes on a true condition", fun() {
  assert(true);
  return "ok";
});

test("try recovers from a raised error", fun() {
  caught = false;
  try {
    assert(false);
  } else e {
    caught = e.message != "";
  }
  if (caught) { return "ok"; }
});

// ---------- DYNAMIC EVAL ----------
test("eval computes without reaching anything", fun() {
  if (eval("5 + 5;") == 10) { return "ok"; }
});

test("eval cannot see the caller", fun() {
  secret = 1;
  try {
    eval("secret + 1;");
  } else e {
    return "ok";
  }
});

// A record is how a snippet is given something to work on, and how what it did
// comes back.
test("eval works on what it is handed", fun() {
  knobs = { speed: 2; };
  eval("speed = speed * 3;", knobs);
  if (knobs.speed == 6) { return "ok"; }
});

// ---------- SUMMARY ----------
print("");
print("=== SUMMARY ===");
print("Tests passed:", passed);
print("Tests failed:", failed);
print("=================");
