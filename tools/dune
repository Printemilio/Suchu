; Build-time only: generates src/fonts_data.ml from assets/fonts.
(executable
 (name embed_fonts)
 (modules embed_fonts))

; The differential suite: runs each program in tests/differential both ways and
; compares the output byte for byte. Not a (test ...) stanza, because it invokes
; 'suchu comp', which invokes dune -- so it has to run when dune is not already
; holding the lock on the build directory. Build it, then run it by hand.
(executable
 (name differential)
 (modules differential)
 (libraries unix))
